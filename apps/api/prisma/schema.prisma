generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
  SPAM
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SocialPlatform {
  GITHUB
  LINKEDIN
  TWITTER
  INSTAGRAM
  YOUTUBE
  WEBSITE
  EMAIL
  OTHER
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  name            String    @db.VarChar(120)
  role            UserRole  @default(EDITOR)
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaSecret       String?   @map("mfa_secret") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  refreshTokens    RefreshToken[]
  projectsCreated  Project[]      @relation("ProjectCreatedBy")
  projectsUpdated  Project[]      @relation("ProjectUpdatedBy")
  auditLogs        AuditLog[]
  siteSettingsUpdated SiteSettings[] @relation("SiteSettingsUpdatedBy")

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@index([userId, revokedAt], map: "idx_refresh_tokens_user_id_revoked_at")
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Content — Projects
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  projects Project[]

  @@index([sortOrder], map: "idx_categories_sort_order")
  @@map("categories")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(200)
  slug        String        @db.VarChar(220)
  summary     String?       @db.VarChar(500)
  content     String?       @db.Text
  categoryId  String?       @map("category_id") @db.Uuid
  createdById String        @map("created_by") @db.Uuid
  updatedById String        @map("updated_by") @db.Uuid
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0) @map("sort_order")
  featured    Boolean       @default(false)
  metadata    Json          @default("{}") @db.JsonB
  seo         Json          @default("{}") @db.JsonB
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  scheduledAt DateTime?     @map("scheduled_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy    User                @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User                @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  images       ProjectImage[]
  technologies ProjectTechnology[]

  @@index([categoryId], map: "idx_projects_category_id")
  @@index([createdById], map: "idx_projects_created_by")
  @@index([updatedById], map: "idx_projects_updated_by")
  @@index([status, publishedAt(sort: Desc)], map: "idx_projects_status_published_at")
  @@index([featured, sortOrder], map: "idx_projects_featured_sort_order")
  @@index([deletedAt], map: "idx_projects_deleted_at")
  @@index([slug], map: "idx_projects_slug")
  @@map("projects")
}

model ProjectImage {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  storageKey String  @map("storage_key") @db.VarChar(500)
  url       String   @db.VarChar(1000)
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_project_images_project_id")
  @@index([projectId, sortOrder], map: "idx_project_images_project_id_sort_order")
  @@index([projectId, isCover], map: "idx_project_images_project_id_is_cover")
  @@map("project_images")
}

model Technology {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  iconUrl     String?  @map("icon_url") @db.VarChar(1000)
  websiteUrl  String?  @map("website_url") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId    String @map("project_id") @db.Uuid
  technologyId String @map("technology_id") @db.Uuid

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId], map: "idx_project_technologies_technology_id")
  @@map("project_technologies")
}

// ---------------------------------------------------------------------------
// Skills & Certifications
// ---------------------------------------------------------------------------

model SkillCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  skills Skill[]

  @@index([sortOrder], map: "idx_skill_categories_sort_order")
  @@map("skill_categories")
}

model Skill {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(100)
  skillCategoryId  String           @map("skill_category_id") @db.Uuid
  proficiencyLevel ProficiencyLevel @default(INTERMEDIATE) @map("proficiency_level")
  sortOrder        Int              @default(0) @map("sort_order")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  skillCategory SkillCategory @relation(fields: [skillCategoryId], references: [id], onDelete: Cascade)

  @@index([skillCategoryId], map: "idx_skills_skill_category_id")
  @@index([skillCategoryId, sortOrder], map: "idx_skills_skill_category_id_sort_order")
  @@map("skills")
}

model Certification {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(200)
  issuer        String    @db.VarChar(200)
  issueDate     DateTime  @map("issue_date") @db.Date
  expiryDate    DateTime? @map("expiry_date") @db.Date
  credentialId  String?   @map("credential_id") @db.VarChar(200)
  credentialUrl String?   @map("credential_url") @db.VarChar(1000)
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sortOrder], map: "idx_certifications_sort_order")
  @@index([issueDate(sort: Desc)], map: "idx_certifications_issue_date")
  @@map("certifications")
}

// ---------------------------------------------------------------------------
// Engagement & Site Config
// ---------------------------------------------------------------------------

model Message {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(120)
  email     String        @db.VarChar(255)
  subject   String?       @db.VarChar(200)
  body      String        @map("message") @db.Text
  status    MessageStatus @default(NEW)
  ipAddress String?       @map("ip_address") @db.VarChar(45)
  userAgent String?       @map("user_agent") @db.VarChar(512)
  readAt    DateTime?     @map("read_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)], map: "idx_messages_status_created_at")
  @@index([email], map: "idx_messages_email")
  @@index([createdAt(sort: Desc)], map: "idx_messages_created_at")
  @@map("messages")
}

model SocialLink {
  id        String         @id @default(uuid()) @db.Uuid
  platform  SocialPlatform
  url       String         @db.VarChar(1000)
  label     String?        @db.VarChar(100)
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "idx_social_links_is_active_sort_order")
  @@map("social_links")
}

model SiteSettings {
  id              String   @id @default(uuid()) @db.Uuid
  siteTitle       String   @map("site_title") @db.VarChar(200)
  siteDescription String?  @map("site_description") @db.VarChar(500)
  ownerName       String   @map("owner_name") @db.VarChar(120)
  logoUrl         String?  @map("logo_url") @db.VarChar(1000)
  faviconUrl      String?  @map("favicon_url") @db.VarChar(1000)
  theme           Json     @default("{}") @db.JsonB
  analytics       Json     @default("{}") @db.JsonB
  updatedById     String?  @map("updated_by") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("SiteSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Uuid
  changes    Json     @default("{}") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([entityType, entityId], map: "idx_audit_logs_entity_type_entity_id")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([action], map: "idx_audit_logs_action")
  @@map("audit_logs")
}
